// Theme colors — auto-generated by matugen from the current wallpaper.
// Do not hand-edit; edit matugen/templates/niri-colors.kdl instead.

layout {
    background-color "transparent"

    focus-ring {
        active-color   "#a7d293"
        inactive-color "#8d9387"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a7d293"
        inactive-color "#8d9387"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a7d293"
        inactive-color "#8d9387"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a7d29380"
    }
}

recent-windows {
    highlight {
        active-color   "#a7d293"
        urgent-color   "#ffb4ab"
    }
}
