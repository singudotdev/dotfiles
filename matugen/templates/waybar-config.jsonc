{
    "layer": "top",
    "position": "top",
    "height": 0,
    "spacing": 4,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": ["niri/workspaces", "custom/sep-left", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "custom/sep0", "pulseaudio", "custom/sep1", "custom/cpu", "custom/sep2", "memory", "custom/sep3", "custom/gpu", "battery", "custom/sep4", "custom/notification"],

    "niri/workspaces": {
        "format": "{value}"
    },
    "custom/sep-left": {
        "format": "|",
        "tooltip": false
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true
    },
    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "clock": {
        "format": " {0:%H:%M} <span font_weight='normal'>|</span> {0:%Y-%m-%d}",
        "format-alt": " {0:%H:%M:%S}",
        "tooltip-format": "{calendar}",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "today": "<span color='{{colors.primary.default.hex}}'><b><u>{}</u></b></span>"
            }
        }
    },
    "tray": {
        "spacing": 8
    },
    "custom/sep0": {
        "format": "|",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL muted",
        "on-click": "swayosd-client --output-volume mute-toggle",
        "scroll-step": 3
    },
    "custom/sep1": {
        "format": "|",
        "tooltip": false
    },
    "custom/cpu": {
        "exec": "cpu-status",
        "return-type": "json",
        "interval": 3,
        "format": "CPU {}"
    },
    "custom/sep2": {
        "format": "|",
        "tooltip": false
    },
    "memory": {
        "format": "RAM {percentage}%",
        "tooltip-format": "Used: {used} GiB\nAvail: {avail} GiB\nTotal: {total} GiB",
        "interval": 2,
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "custom/sep3": {
        "format": "|",
        "tooltip": false
    },
    "custom/gpu": {
        "exec": "gpu-status",
        "return-type": "json",
        "interval": 3,
        "format": "GPU {}"
    },
    "battery": {
        "format": "BAT {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        }
    },
    "custom/sep4": {
        "format": "|",
        "tooltip": false
    }
}
